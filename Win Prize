<!DOCTYPE html>
<html lang="my">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>🎉 အထူးလက်ဆောင် - Win A Prize! 🎉</title>
    <!-- Tailwind CSS for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Padauk:wght@400;700&display=swap');
        
        body {
            font-family: 'Padauk', sans-serif;
            margin: 0;
            overflow: hidden; /* ခလုတ်ပြေးတဲ့အခါ မျက်နှာပြင် မရွေ့အောင်လုပ်ထားခြင်း */
            height: 100vh;
            width: 100vw;
            background: linear-gradient(-45deg, #FFD700, #FF8C00, #FF1493, #00BFFF);
            background-size: 400% 400%;
            animation: gradientBG 10s ease infinite;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Glassmorphism Effect */
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }

        #runaway-btn {
            transition: all 0.2s ease-out; /* ခလုတ်ပြေးတဲ့ အမြန်နှုန်း */
            z-index: 50; 
        }
        
        .float-animation {
            animation: float 3s ease-in-out infinite;
        }
        
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
            100% { transform: translateY(0px); }
        }
    </style>
</head>
<body>

    <div class="relative z-10 w-full max-w-md mx-4 float-animation">
        
        <div class="glass-card rounded-3xl p-8 text-center">
            
            <!-- Icon/Emoji -->
            <div class="text-7xl mb-4 animate-bounce">🎁</div>
            
            <!-- Title -->
            <h1 class="text-3xl md:text-4xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-red-600 to-purple-600">
                🎉 ကံထူးရှင် ဖြစ်သွားပါပြီ! 🎉
            </h1>
            
            <!-- Description -->
            <p class="text-gray-800 text-lg md:text-xl mb-8 font-semibold">
                သင့်အတွက် ငွေသားလက်ဆောင် ကျပ် (၁၀) သိန်း ရရှိထားပါတယ်။ အောက်ပါခလုတ်ကို နှိပ်ပြီး ချက်ချင်း ထုတ်ယူလိုက်ပါ။
            </p>
            
            <div class="flex flex-col md:flex-row justify-center items-center gap-4 relative min-h-[60px]">
                
                <!-- Claim Button -->
                <button id="claim-btn" onclick="showPrank()" class="w-full md:w-auto bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white font-bold py-3 px-8 rounded-full shadow-lg transform transition hover:scale-105 animate-pulse text-lg border-2 border-green-300">
                    💰 ထုတ်ယူမည် 💰
                </button>
                
                <!-- Runaway Button -->
                <button id="runaway-btn" class="w-full md:w-auto bg-gray-300 hover:bg-red-500 hover:text-white text-gray-700 font-bold py-3 px-8 rounded-full shadow-md text-lg border-2 border-gray-400">
                    ❌ ပြန်ထွက်မည်
                </button>
                
            </div>

            <!-- Hidden Message Box -->
            <div id="prank-msg" class="hidden mt-8 bg-red-100 border-l-4 border-red-600 p-5 rounded shadow-inner text-left transition-all duration-500 transform scale-95 opacity-0">
                <p class="text-red-700 font-bold text-base md:text-lg mb-2 flex items-center">
                    <span class="text-2xl mr-2">🚨</span> သတိ! လင့်ခ်အတု ပညာပေးစမ်းသပ်မှု
                </p>
                <p class="text-red-800 text-sm md:text-base leading-relaxed">
                    ဒါဟာ သူငယ်ချင်းတွေကို စနောက်ဖို့နဲ့ ဆိုက်ဘာလုံခြုံရေး ပညာပေးဖို့ ပြုလုပ်ထားတာပါ။ တကယ့်အပြင်မှာ မသိတဲ့ လင့်ခ်တွေကို ဝင်နှိပ်မိရင် သင့်ဖုန်းထဲက အချက်အလက်တွေ အခိုးခံရနိုင်ပါတယ်။ 😉
                </p>
            </div>

        </div>
    </div>

    <!-- Confetti Script for winning effect -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        const runawayBtn = document.getElementById('runaway-btn');
        let isAbsolute = false;

        // --- Web Audio API အသုံးပြု၍ အသံဖန်တီးခြင်း ---
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        
        function playSound(type) {
            if (audioCtx.state === 'suspended') {
                audioCtx.resume(); // Browser က အသံပိတ်ထားရင် ပြန်ဖွင့်ပေးဖို့
            }
            
            const oscillator = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();
            
            oscillator.connect(gainNode);
            gainNode.connect(audioCtx.destination);
            
            if (type === 'run') {
                // ပြေးတဲ့အခါ ထွက်မယ့်အသံ (Quick high pitch)
                oscillator.type = 'sine';
                oscillator.frequency.setValueAtTime(800, audioCtx.currentTime);
                oscillator.frequency.exponentialRampToValueAtTime(300, audioCtx.currentTime + 0.1);
                gainNode.gain.setValueAtTime(0.3, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.1);
            } else if (type === 'claim') {
                // နှိပ်လိုက်တဲ့အခါ ထွက်မယ့်အသံ (Success sound)
                oscillator.type = 'triangle';
                oscillator.frequency.setValueAtTime(400, audioCtx.currentTime);
                oscillator.frequency.linearRampToValueAtTime(600, audioCtx.currentTime + 0.2);
                gainNode.gain.setValueAtTime(0.5, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);
                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.5);
            }
        }

        // --- ခလုတ်ကို လျှောက်ပြေးစေမည့် Function ---
        function moveButton() {
            playSound('run'); // ပြေးတဲ့အသံ ဖွင့်မယ်
            
            const btnWidth = runawayBtn.offsetWidth;
            const btnHeight = runawayBtn.offsetHeight;
            
            const maxX = window.innerWidth - btnWidth - 20; 
            const maxY = window.innerHeight - btnHeight - 20;
            
            const randomX = Math.max(10, Math.floor(Math.random() * maxX));
            const randomY = Math.max(10, Math.floor(Math.random() * maxY));
            
            if (!isAbsolute) {
                runawayBtn.style.position = 'fixed';
                runawayBtn.style.width = 'auto'; 
                isAbsolute = true;
            }
            
            runawayBtn.style.left = randomX + 'px';
            runawayBtn.style.top = randomY + 'px';
        }

        // ကွန်ပျူတာအတွက် (Mouse တင်လိုက်တာနဲ့ ပြေးမယ်)
        runawayBtn.addEventListener('mouseover', moveButton);
        
        // ဖုန်းအတွက် (ထိလိုက်တာနဲ့ ပြေးမယ်)
        runawayBtn.addEventListener('touchstart', function(e) {
            e.preventDefault(); 
            moveButton();
        }, { passive: false });

        // --- ထုတ်ယူမည် ကို နှိပ်လျှင် ---
        function showPrank() {
            playSound('claim'); // အောင်မြင်တဲ့ အသံဖွင့်မယ်
            
            // Confetti (စက္ကူစလေးတွေ ကြဲချမယ်)
            confetti({
                particleCount: 150,
                spread: 70,
                origin: { y: 0.6 }
            });

            const msgBox = document.getElementById('prank-msg');
            const claimBtn = document.getElementById('claim-btn');
            
            // စာသားကို ပြမယ်
            msgBox.classList.remove('hidden');
            setTimeout(() => {
                msgBox.classList.remove('scale-95', 'opacity-0');
                msgBox.classList.add('scale-100', 'opacity-100');
            }, 50);

            // ခလုတ်ကို ထပ်နှိပ်လို့မရအောင် ပိတ်မယ်
            claimBtn.classList.remove('animate-pulse', 'from-green-500', 'to-emerald-600', 'hover:from-green-600', 'hover:to-emerald-700');
            claimBtn.classList.add('bg-gray-500', 'cursor-not-allowed');
            claimBtn.disabled = true;
            claimBtn.innerText = "စမ်းသပ်မှု ပြီးဆုံးပါပြီ";
        }
    </script>
</body>
</html>