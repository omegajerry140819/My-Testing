<!DOCTYPE html>
<html lang="my">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>🎉 အထူးလက်ဆောင် - Win A Prize! 🎉</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Padauk:wght@400;700&display=swap');
        
        body {
            font-family: 'Padauk', sans-serif; /* Using Myanmar font */
            margin: 0;
            overflow: hidden; /* Prevent scrolling when button runs away */
            height: 100vh;
            width: 100vw;
            background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
            background-size: 400% 400%;
            animation: gradientBG 10s ease infinite;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        #runaway-btn {
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            z-index: 50; /* Ensure it stays on top */
        }
        
        /* Floating animation for the card */
        .float-animation {
            animation: float 4s ease-in-out infinite;
        }
        
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }
    </style>
</head>
<body>

    <div class="relative z-10 w-full max-w-md mx-4 float-animation">
        <!-- Glassmorphism Card -->
        <div class="bg-white/90 backdrop-blur-xl border border-white/50 rounded-3xl p-8 shadow-2xl text-center">
            
            <!-- Icon/Emoji -->
            <div class="text-6xl mb-4 animate-bounce">🎁</div>
            
            <!-- Title -->
            <h1 class="text-2xl md:text-3xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-pink-500">
                🎉 ဂုဏ်ယူပါတယ်! သင် ဆုပေါက်သွားပါပြီ! 🎉
            </h1>
            
            <!-- Description -->
            <p class="text-gray-600 text-base md:text-lg mb-8 leading-relaxed">
                သင့်အကောင့်အတွက် အထူးလက်ဆောင်ရရှိထားပါတယ်။ အောက်ပါခလုတ်ကို နှိပ်ပြီး ဆုငွေကို ထုတ်ယူပါ။
            </p>
            
            <div class="flex flex-col md:flex-row justify-center items-center gap-4 relative min-h-[50px]">
                
                <!-- Claim Button -->
                <button id="claim-btn" onclick="showPrank()" class="w-full md:w-auto bg-gradient-to-r from-green-400 to-emerald-600 hover:from-green-500 hover:to-emerald-700 text-white font-bold py-3 px-8 rounded-full shadow-lg transform transition hover:scale-105 animate-pulse">
                    ထုတ်ယူမည်
                </button>
                
                <!-- Runaway Button -->
                <button id="runaway-btn" class="w-full md:w-auto bg-gray-200 hover:bg-red-500 hover:text-white text-gray-700 font-bold py-3 px-8 rounded-full shadow-md">
                    ပြန်ထွက်မည်
                </button>
                
            </div>

            <!-- Hidden Message Box -->
            <div id="prank-msg" class="hidden mt-6 bg-red-50 border-l-4 border-red-500 p-5 rounded-r-lg shadow-inner text-left transition-all duration-500 transform scale-95 opacity-0">
                <p class="text-red-700 font-bold text-sm md:text-base mb-2">
                    🚨 သတိ! ဒါကတော့ လင့်ခ်အတုတွေကို မနှိပ်မိဖို့ ပညာပေး စမ်းသပ်မှုတစ်ခုသာ ဖြစ်ပါတယ်။ 🚨
                </p>
                <p class="text-red-600 text-sm">
                    တကယ်သာဆိုရင် သင့်အချက်အလက်တွေ အခိုးခံရနိုင်ပါတယ်။ နောက်ဆို မသိတဲ့ လင့်ခ်တွေကို မနှိပ်ပါနဲ့နော်! 😉
                </p>
            </div>

        </div>
    </div>

    <script>
        const runawayBtn = document.getElementById('runaway-btn');
        let isAbsolute = false;

        function moveButton() {
            // Get the button's dimensions
            const btnWidth = runawayBtn.offsetWidth;
            const btnHeight = runawayBtn.offsetHeight;
            
            // Calculate maximum boundaries to keep the button on the screen
            const maxX = window.innerWidth - btnWidth - 20; 
            const maxY = window.innerHeight - btnHeight - 20;
            
            // Generate random X and Y positions
            const randomX = Math.max(10, Math.floor(Math.random() * maxX));
            const randomY = Math.max(10, Math.floor(Math.random() * maxY));
            
            // Change position to fixed so it can fly anywhere on the screen
            if (!isAbsolute) {
                runawayBtn.style.position = 'fixed';
                runawayBtn.style.width = 'auto'; // Remove full width on mobile once it runs
                isAbsolute = true;
            }
            
            // Apply the new position
            runawayBtn.style.left = randomX + 'px';
            runawayBtn.style.top = randomY + 'px';
        }

        // Trigger movement on mouse hover (Desktop)
        runawayBtn.addEventListener('mouseover', moveButton);
        
        // Trigger movement on touch (Mobile)
        runawayBtn.addEventListener('touchstart', function(e) {
            e.preventDefault(); // Prevent actual clicking
            moveButton();
        }, { passive: false });

        function showPrank() {
            const msgBox = document.getElementById('prank-msg');
            const claimBtn = document.getElementById('claim-btn');
            
            // Show the message
            msgBox.classList.remove('hidden');
            
            // Small delay to allow display:block to apply before animating opacity
            setTimeout(() => {
                msgBox.classList.remove('scale-95', 'opacity-0');
                msgBox.classList.add('scale-100', 'opacity-100');
            }, 50);

            // Stop the claim button from pulsing
            claimBtn.classList.remove('animate-pulse');
            claimBtn.classList.add('bg-gray-400', 'cursor-not-allowed');
            claimBtn.disabled = true;
            claimBtn.innerText = "ထုတ်ယူပြီးပါပြီ";
        }
    </script>
</body>
</html>